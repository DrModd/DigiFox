#!/bin/sh
# amp-hush [мс] — приглушить усилитель DigiD D1 на время (по умолчанию 1500 мс),
# пока плеер выключается и включается другой: иначе DSD, оборванный посреди потока,
# щёлкает (AK4137 видит, что такты DSD пропали). Только в режиме АК — в режиме
# Фокс выход пересчёта идёт без перерыва. Усилитель снимет заглушение сам.
[ "$(cat /etc/digifox/srcmode 2>/dev/null)" = fox ] && exit 0
[ -c /dev/ttyS2 ] || exit 0
ms=${1:-1500}
# с тайм-аутом: запись в UART не должна подвесить переключение плеера (и веб)
timeout 1 sh -c "printf '@HUSH %s\\n' $ms > /dev/ttyS2" 2>/dev/null
sleep 0.05          # усилителю ~20 мс на заглушение
exit 0
