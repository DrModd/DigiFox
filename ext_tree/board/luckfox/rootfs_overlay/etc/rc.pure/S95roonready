#!/bin/sh


start() {
    printf "Starting RoonBrige: "
    MAC=`cat /sys/class/net/eth0/address | tr 'a-z' 'A-Z'`
    sed -i "s/^.*\"unique_id\".*/    \"unique_id\": \"$MAC\" ,/" /etc/raat.conf
    renice -15 $$ 
    # DigiFox, режим ФОКС: выход — модуль пересчёта (ALSA ioplug, у него нет номера
    # карты), raat_app без номера карты не находит форматов — подсказать карту 0
    PRE=""
    [ "$(cat /etc/digifox/srcmode 2>/dev/null)" = fox ] && [ -f /usr/lib/digifox/raat_card.so ] && \
        PRE=/usr/lib/digifox/raat_card.so
    LD_PRELOAD=$PRE /opt/RoonReady/raat_app /etc/raat.conf > /dev/null 2>&1 &
    # DigiFox: транспорт hifiberry (MPRIS по D-Bus — кнопки плеера с пульта усилителя).
    # Если raat_app с ним не поднялся (нет D-Bus и т. п.) — запустить без него, как раньше.
    if grep -q '"transport"' /etc/raat.conf; then
        sleep 3
        if ! pidof raat_app >/dev/null; then
            sed '/"transport"/,/},/d' /etc/raat.conf > /tmp/raat_plain.conf
            echo "$(date '+%d.%m %H:%M:%S') roon: raat_app не стартовал с транспортом — без кнопок пульта" >> /tmp/digifox_events.log
            LD_PRELOAD=$PRE /opt/RoonReady/raat_app /tmp/raat_plain.conf > /dev/null 2>&1 &
        fi
    fi
    # название трека, обложка и позиция для экрана усилителя и приложения (MPRIS -> /tmp/nowplaying)
    ( sleep 4; /usr/bin/pfmeta roon ) >/dev/null 2>&1 &
    sleep 0.5
    if [ -f /tmp/mixer_control_cache ]; then
        MIXER=$(cat /tmp/mixer_control_cache | cut -d, -f1 | tr -d "'")
        [ -n "$MIXER" ] && amixer set "$MIXER" unmute 2>/dev/null
    fi
    }
stop() {
    killall -9 raat_app
    [ -f /tmp/pfmeta_roon.pid ] && kill "$(cat /tmp/pfmeta_roon.pid)" 2>/dev/null; rm -f /tmp/pfmeta_roon.pid
}
restart() {
	stop
	start
}
case "$1" in
  start|stop|restart)
	"$1"
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
