#!/bin/sh


start() {
    printf "Starting Spotify: "
    
    # Determine active ALSA card number from asound.conf
    CARD_NUM=$(grep -E "card [0-9]" /etc/asound.conf 2>/dev/null | head -1 | awk '{print $2}')
    if [ -z "$CARD_NUM" ]; then
        # Fallback: try hw:X,X pattern
        CARD_NUM=$(grep -E "hw:[0-9]" /etc/asound.conf 2>/dev/null | head -1 | sed 's/.*hw:\([0-9]\).*/\1/')
    fi
    [ -z "$CARD_NUM" ] && CARD_NUM=0
    
    # Check if sound card exists before starting librespot
    if [ ! -d "/proc/asound/card$CARD_NUM" ]; then
        echo "ERROR: Sound card $CARD_NUM not found (configured in /etc/asound.conf but device missing)"
        echo "Available cards:"
        ls -d /proc/asound/card* 2>/dev/null || echo "  No sound cards detected"
        echo "Librespot will panic with 100% CPU if started without audio device. Aborting."
        exit 1
    fi
    
    NAME=`hostname`_`ifconfig eth0 | awk '/inet addr/{print substr($2,6)}'`

    # DigiFox: Spotify Soloist — официальный плеер Spotify, если введён ключ (Настройки →
    # Spotify). go-librespot и librespot Spotify на части аккаунтов не отдаёт ключи треков
    # ("audio key error" / "code 1"); Soloist работает на движке приложений Spotify.
    # Нет ключа, не скачался или не запустился — go-librespot, как раньше.
    SKEY=/etc/digifox/soloist.key
    SDIR=/var/lib/digifox/soloist
    # скачать или обновить (через 60 дней) — в фоне, запуск плеера не ждёт
    [ -s $SKEY ] && { /usr/bin/digifox-soloist ensure >/dev/null 2>&1 & }
    if [ -s $SKEY ] && [ ! -f /etc/digifox/spotify-legacy ] && [ -x $SDIR/soloist ]; then
        mkdir -p /etc/digifox/soloist $SDIR/cache
        # звук: libpulse.so.0 из /usr/lib/digifox/soloist (soloist-shim) — прямо в ALSA, без
        # PulseAudio. LD_PRELOAD: библиотека сама стирает ключ из командной строки (ps).
        # Громкость Spotify не трогает сэмплы (APULSE_EXTERNAL_VOLUME: громкость — у усилителя).
        # APULSE_MAX_TLENGTH_MS=500: в буфере 0,5 с, а не 2 с — пауза и смена трека без задержки.
        # touch /etc/digifox/soloist-debug — подробный журнал звука в /tmp/soloist.log
        [ -f /etc/digifox/soloist-debug ] && export APULSE_DIAG=1
        LD_PRELOAD=/usr/lib/digifox/soloist/libpulse.so.0 LD_LIBRARY_PATH=/usr/lib/digifox/soloist \
        APULSE_PLAYBACK_DEVICE=plug:default APULSE_EXTERNAL_VOLUME=1 APULSE_MAX_TLENGTH_MS=500 \
        $SDIR/soloist -n "$NAME" -k "$(cat $SKEY)" -D /etc/digifox/soloist \
            -C $SDIR/cache -z 100 -i 100 -w 127.0.0.1:3679 > /tmp/soloist.log 2>&1 &
        SPID=$!
        echo $SPID > /tmp/spotify.pid
        sleep 3
        if kill -0 $SPID 2>/dev/null; then
            renice -15 $SPID 2>/dev/null
            ( sleep 2; /usr/bin/pfmeta spotify-soloist ) >/dev/null 2>&1 &
            echo "OK (Spotify Soloist)"
            return 0
        fi
        wait $SPID 2>/dev/null; rc=$?
        # 10 — сборка устарела (90 дней): скачать новую в фоне, сейчас — go-librespot
        [ $rc = 10 ] && { /usr/bin/digifox-soloist fetch >/dev/null 2>&1 & }
        echo "$(date '+%d.%m %H:%M:%S') spotify: Soloist не запустился (код $rc: $(tail -1 /tmp/soloist.log)) — go-librespot" >> /tmp/digifox_events.log
    fi

    # DigiFox: go-librespot (REST API: кнопки плеера с пульта и из приложения, точный
    # трек и позиция). Не поднялся — прежний librespot. Вернуть прежний насовсем:
    # touch /etc/digifox/spotify-legacy
    GLR=/usr/lib/go-librespot/librespot
    if [ -x $GLR ] && [ ! -f /etc/digifox/spotify-legacy ]; then
        CFG=/etc/digifox/go-librespot
        mkdir -p $CFG
        cat > $CFG/config.yml <<EOF
log_level: info
device_name: "$NAME"
device_type: speaker
audio_backend: alsa
audio_device: default
mixer_device: ""
external_volume: true
initial_volume: 100
volume_steps: 100
bitrate: 320
flac_enabled: false
normalisation_disabled: true
zeroconf_enabled: true
zeroconf_backend: avahi
credentials:
  type: zeroconf
  zeroconf:
    persist_credentials: true
server:
  enabled: true
  address: 127.0.0.1
  port: 3678
EOF
        # 0.10.x: флаги в стиле pflag — «-config_dir» читался как «-c onfig_dir» и go-librespot
        # падал сразу (оставался старый librespot, которому Spotify не отдаёт ключи треков)
        $GLR --config_dir $CFG > /tmp/librespot.log 2>&1 &
        GPID=$!
        echo $GPID > /tmp/spotify.pid
        sleep 3
        if kill -0 $GPID 2>/dev/null; then
            renice -15 $GPID 2>/dev/null
            ( sleep 2; /usr/bin/pfmeta spotify-api ) >/dev/null 2>&1 &
            echo "OK (go-librespot)"
            return 0
        fi
        echo "$(date '+%d.%m %H:%M:%S') spotify: go-librespot не запустился ($(tail -1 /tmp/librespot.log)) — прежний librespot" >> /tmp/digifox_events.log
    fi

    /usr/bin/librespot \
        --cache /tmp --cache-size-limit 12M \
        --bitrate 320 \
	--initial-volume 100 --onevent /usr/bin/pfmeta_spotify \
	--volume-ctrl fixed \
        --name $NAME > /tmp/librespot.log 2>&1 &
    LIBRESPOT_PID=$!
    echo $LIBRESPOT_PID > /tmp/spotify.pid
    renice -15 $LIBRESPOT_PID 2>/dev/null
    sleep 0.5
    if ! kill -0 $LIBRESPOT_PID 2>/dev/null; then
        echo "failed"
        return 1
    fi
    if [ -f /tmp/mixer_control_cache ]; then
        MIXER=$(cat /tmp/mixer_control_cache | cut -d, -f1 | tr -d "'")
        [ -n "$MIXER" ] && amixer set "$MIXER" unmute 2>/dev/null
    fi
}

stop() {
    killall soloist 2>/dev/null; sleep 0.3; killall -9 soloist 2>/dev/null
    killall -9 librespot 2>/dev/null
    rm -f /tmp/spotify.pid
    [ -f /tmp/pfmeta_spotify.pid ] && kill "$(cat /tmp/pfmeta_spotify.pid)" 2>/dev/null; rm -f /tmp/pfmeta_spotify.pid
}
restart() {
	stop
	start
}
case "$1" in
  start|stop|restart)
	"$1"
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
