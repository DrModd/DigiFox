#!/bin/sh

. /opt/audio-card-utils.sh

get_output_device() {
    if [ -f /etc/output ] && grep -q "USB" /etc/output; then
        usb_audio_device || echo "default"
    else
        echo "default"
    fi
}

restore_mixer() {
    [ -f /tmp/mixer_control_cache ] || return 0

    mixer=$(cut -d, -f1 /tmp/mixer_control_cache | tr -d "'")
    [ -n "$mixer" ] && amixer set "$mixer" unmute 2>/dev/null
}

# DigiFox: открытый плеер qobine (SofusA/qobine, connect-module) вместо плеера из SDK —
# пробный, для сравнения. Включить: echo qobine > /etc/digifox/qobuz-engine, вернуть:
# rm /etc/digifox/qobuz-engine. Процесс тоже называется qobuz-connect.
QOBINE=/usr/lib/qobine/qobuz-connect
start_qobine() {
    mkdir -p /etc/digifox/qobine
    # название трека (/tmp/nowplaying, /tmp/np_prog) и управление (FIFO /tmp/qobuz_ctl)
    # qobine пишет сам (патч DigiFox в package/qobine) — pfmeta не нужен
    rm -f /tmp/nowplaying /tmp/np_prog
    # база (настройки, вход) — в $HOME/.local/share: держим её среди настроек DigiFox
    HOME=/etc/digifox/qobine RUST_LOG=info \
        nice -n -15 $QOBINE --no-login --connect-name DigiFox > /tmp/qobine.log 2>&1 &
    sleep 3
    if pidof qobuz-connect >/dev/null; then restore_mixer; return 0; fi
    echo "$(date '+%d.%m %H:%M:%S') qobuz: qobine не запустился ($(tail -1 /tmp/qobine.log)) — плеер из SDK" >> /tmp/digifox_events.log
    return 1
}

start_qobuz() {
    if [ "$(cat /etc/digifox/qobuz-engine 2>/dev/null)" = qobine ] && [ -x $QOBINE ]; then
        start_qobine && return 0
    fi
    output_device="$(get_output_device)"

    export LD_PRELOAD=/usr/lib/libassert_hook.so
    /bin/sh -c 'export LD_PRELOAD=/usr/lib/libassert_hook.so; renice -15 $$ >/dev/null 2>&1; exec /opt/qobuz-connect/qobuz-connect -l DigiFox -o "$1"' sh \
        "$output_device" 2>&1 | /usr/bin/pfmeta qobuz >/dev/null 2>&1 &

    restore_mixer
}

start() {
    printf "Starting Qobuz Connect: "
    start_qobuz > /dev/null 2>&1 &
}

stop() {
    pid="$(pidof qobuz-connect)"

    if [ -n "$pid" ]; then
        kill -9 "$pid"
        echo "Stopped qobuz-connect (PID: $pid)"
    else
        echo "qobuz-connect not running"
    fi
}

restart() {
    stop
    start
}

case "$1" in
    start|stop|restart)
        "$1"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
