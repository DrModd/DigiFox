#!/bin/sh
#
# UAC2 -> I2S Router startup script
#

DAEMON=/opt/uac2_router
PIDFILE=/var/run/uac2_router.pid

start() {
    printf "Starting UAC2 router: "

    # Wait for UAC2 gadget to be ready
    for i in 1 2 3 4 5; do
        if [ -d /sys/class/u_audio ]; then
            break
        fi
        sleep 1
    done

    if [ ! -d /sys/class/u_audio ]; then
        echo "FAIL (UAC2 device not found)"
        return 1
    fi

    # DigiFox: под присмотром — роутер завис (сторож внутри выходит с кодом 3)
    # или упал — запустить снова; выход 0 (stop) — конец. Больше 5 перезапусков
    # за минуту — пауза 10 с, чтобы не крутиться.
    start-stop-daemon -S -q -b -m -p $PIDFILE --exec /bin/sh -- -c '
        n=0; t0=$(date +%s)
        while :; do
            '$DAEMON'; rc=$?
            [ $rc = 0 ] && break
            echo "$(date "+%d.%m %H:%M:%S") USB router: exited ($rc), restarting" >> /tmp/digifox_events.log
            now=$(date +%s)
            if [ $((now - t0)) -ge 60 ]; then n=0; t0=$now; fi
            n=$((n + 1)); [ $n -gt 5 ] && sleep 10
            sleep 1
        done'
    rc=$?
    sleep 0.2
    renice -15 $(pidof uac2_router) >/dev/null 2>&1
    if [ $rc = 0 ]; then
        echo "OK"
    else
        echo "FAIL"
    fi
}

stop() {
    printf "Stopping UAC2 router: "
    start-stop-daemon -K -q -p $PIDFILE
    rc=$?
    killall -TERM uac2_router 2>/dev/null     # сам роутер (присмотр уже остановлен)
    if [ $rc = 0 ]; then
        rm -f $PIDFILE
        echo "OK"
    else
        echo "FAIL"
    fi
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
